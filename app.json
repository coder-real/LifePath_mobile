{
  "expo": {
    "name": "LiFePath",
    "slug": "lifepath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lifepath",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lifepath.app"
    },
    "android": {
      "package": "com.lifepath.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://qdyczaaeffygzwqszjwk.supabase.co",
      "supabaseAnonKey": "sb_publishable_I_mdeEinfgy9abBDnuGYQQ_wdsvYuZo",
      "router": {
        "origin": false
      }
    }
  }
}
